{
  "name": "@ios-shortcuts/ai-response",
  "version": "0.2.2",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "dependencies": {},
  "nx": {
    "sourceRoot": "ai-response/src",
