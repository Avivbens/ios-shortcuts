{
  "$schema": "https://json-schema.org/schema",
  "$id": "GenerateLibrary",
  "title": "Generate Library Options",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Library name, imported as @ios-shortcuts/<name>",
      "$default": {
        "$source": "argv",
        "index": 0
      },
      "x-prompt": "What name would you like to use?"
    }
  },
  "required": ["name"]
}
