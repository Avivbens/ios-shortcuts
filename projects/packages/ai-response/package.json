{
  "name": "@ios-shortcuts/ai-response",
  "version": "0.2.3",
  "private": true,
  "description": "Get AI suggestions for your current chat (support any chat app)",
  "dependencies": {},
  "devDependencies": {
    "@ios-shortcuts/builder": "workspace:*",
    "@ios-shortcuts/shortcut": "workspace:*",
    "@ios-shortcuts/updater": "workspace:*"
  },
  "nx": {
    "sourceRoot": "projects/packages/ai-response/src",
    "projectType": "application",
    "name": "ai-response",
    "targets": {
      "build": {},
      "sign": {},
      "serve": {},
      "lint": {},
      "nx-release-publish": {
        "options": {
          "packageJson": "projects/packages/ai-response/package.json",
          "updateBuildableProjectDepsInPackageJson": false,
          "updateBuildableProjectDepsInWorkspace": false,
          "showOutputPath": true
        }
      }
    }
  }
}
