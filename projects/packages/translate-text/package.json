{
  "name": "@ios-shortcuts/translate-text",
  "version": "0.2.4",
  "private": true,
  "description": "Translate text from the Share Sheet, clipboard, or free-style input using AI",
  "dependencies": {},
  "devDependencies": {
    "@ios-shortcuts/builder": "workspace:*",
    "@ios-shortcuts/shortcut": "workspace:*",
    "@ios-shortcuts/updater": "workspace:*"
  },
  "nx": {
    "sourceRoot": "projects/packages/translate-text/src",
    "projectType": "application",
    "name": "translate-text",
    "targets": {
      "build": {},
      "sign": {},
      "serve": {},
      "lint": {},
      "nx-release-publish": {
        "options": {
          "packageJson": "projects/packages/translate-text/package.json",
          "updateBuildableProjectDepsInPackageJson": false,
          "updateBuildableProjectDepsInWorkspace": false,
          "showOutputPath": true
        }
      }
    }
  }
}
