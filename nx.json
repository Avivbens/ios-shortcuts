{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "parallel": 10,
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.[mc]?[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/release-master.yaml"],
    "plugins": ["{workspaceRoot}/projects/workspace/src/plugins/**"]
  },
  "plugins": [
    "@ios-shortcuts/workspace",
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    },
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    }
  ],
  "targetDefaults": {
    "build": {
      "executor": "@ios-shortcuts/workspace:build",
      "defaultConfiguration": "local",
      "outputs": ["{workspaceRoot}/dist/{projectName}"],
      "configurations": {
        "local": {},
        "ci": {}
      }
    },
    "sign": {
      "executor": "@ios-shortcuts/workspace:sign",
      "defaultConfiguration": "local",
      "dependsOn": [
        {
          "target": "build",
          "params": "forward"
        }
      ],
      "outputs": ["{workspaceRoot}/dist/{projectName}"],
      "configurations": {
        "local": {},
        "ci": {}
      }
    },
    "serve": {
      "executor": "nx:run-commands",
      "defaultConfiguration": "local",
      "dependsOn": [
        {
          "target": "sign",
          "params": "forward"
        }
      ],
      "configurations": {
        "local": {}
      },
      "options": {
        "cwd": "{workspaceRoot}/dist/{projectName}",
        "command": "open ./*.shortcut",
        "parallel": false
      }
    },
    "lint": {
      "inputs": ["default", "^default", "{workspaceRoot}/eslint.config.mjs", "{workspaceRoot}/.prettierrc"],
      "cache": true
    },
    "test": {
      "inputs": ["default", "^default", "{workspaceRoot}/vitest.shared.mts"]
    },
    "unwrap": {
      "executor": "@ios-shortcuts/workspace:unwrap"
    }
  },
  "release": {
    "projects": ["projects/packages/*"],
    "projectsRelationship": "independent",
    "git": {
      "commitMessage": "chore(release): release {version} [skip ci]"
    },
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "conventionalCommits": {
      "useCommitScope": false
    },
    "releaseTag": {
      "pattern": "release/{projectName}/{version}"
    }
  },
  "analytics": false
}
