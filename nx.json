{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/eslint.config.mjs",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/vitest.config.[mc]?[jt]s",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": ["{workspaceRoot}/.github/workflows/release-master.yaml"],
    "plugins": ["{workspaceRoot}/projects/workspace/src/plugins/**"]
  },
  "plugins": [
    "@ios-shortcuts/workspace",
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint"
      }
    },
    {
      "plugin": "@nx/vitest",
      "options": {
        "testTargetName": "test",
        "testMode": "run"
      }
    }
  ],
  "targetDefaults": {
    "test": {
      "inputs": ["default", "^default", "{workspaceRoot}/vitest.shared.mts"]
    }
  },
  "release": {
    "projects": ["projects/packages/*"],
    "projectsRelationship": "independent",
    "git": {
      "commitMessage": "chore(release): release {version} [skip ci]"
    },
    "version": {
      "conventionalCommits": true
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": {
        "createRelease": "github"
      }
    },
    "conventionalCommits": {
      "types": {
        "docs": {
          "semverBump": "patch"
        },
        "feat": {
          "semverBump": "none"
        },
        "fix": {
          "semverBump": "none"
        }
      }
    },
    "releaseTag": {
      "pattern": "release/{projectName}/{version}"
    }
  },
  "analytics": false
}
